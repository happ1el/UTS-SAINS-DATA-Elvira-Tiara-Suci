@'
# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.venv/
venv/
env/

# Jupyter Notebook
.ipynb_checkpoints/

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE and editor
.vscode/
.idea/

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Temporary files
*.tmp
*.bak

# Data and generated outputs
data/
datasets/
*.csv
*.parquet

# Model files
*.pkl
*.pickle
*.joblib

# Python package build files
build/
dist/
*.egg-info/
'@ | Set-Content -Encoding UTF8 .gitignore